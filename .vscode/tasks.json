{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "docker-build: debug",
            "type": "shell",
            "command": "docker build .",
            "problemMatcher": []
        },
        {
            "label": "docker-run: debug",
            "type": "shell",
            "command": "docker compose -f docker-compose.yml -f docker-compose.debug.yml up",
            "dependsOn": [
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "Waiting for debugger to attach..."
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^(Waiting for debugger to attach...)"
                }
            }
        }
    ]
}

